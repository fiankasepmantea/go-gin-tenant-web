# Copy to .env.local (ignored by git). Never put secrets in this example file.
# Base URL of the Go API. Only the Next.js server calls it; the browser never does.
API_URL=http://localhost:8080

# Optional. Subdomain mode: https://acme.<this value> means tenant "acme" and the login form does not ask for a code.
# Empty (default) = the form asks for the tenant code. For local testing use "localhost" and open http://acme.localhost:3000.
# This is the web app's own variable; it is separate from the API's TENANT_BASE_DOMAIN.
TENANT_BASE_DOMAIN=

# Optional. true = send the Content-Security-Policy as Report-Only (log violations, block nothing). Default false.
CSP_REPORT_ONLY=false
