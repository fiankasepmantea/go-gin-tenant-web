  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^15.1.0",
    "openapi-typescript": "^7.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.10"
    }
  }
